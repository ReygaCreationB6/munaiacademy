# ============================================================
# MUN AI Academy — Environment Configuration
# ============================================================

# ---- Server ----
PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# ---- Built-in AI ----
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
ALLOW_CLIENT_KEYS=true

# ---- AI quotas (per IP) ----
AI_QUOTA_BURST_PER_MIN=8
AI_QUOTA_DAILY=50
AI_QUOTA_BURST_PER_MIN_BYO=20
AI_QUOTA_DAILY_BYO=500

# ---- Timeouts & retries ----
AI_TIMEOUT_MS=90000
AI_RETRY_ATTEMPTS=2

# ---- WebSocket limits ----
WS_MAX_CONNECTIONS_PER_IP=10
WS_MAX_MESSAGES_PER_MIN=120

# ---- Supabase (browser) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Supabase (server) ----
# service_role secret — used only by the room persistence layer.
SUPABASE_SERVICE_KEY=

# ---- Sentry (optional) ----
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Site ----
SITE_NAME="MUN AI Academy"
SITE_URL=https://your-domain.com
CONTACT_EMAIL=you@example.com

# ============================================================
# Content authoring (optional)
# ============================================================
# Comma-separated list of email addresses that are allowed to use the
# author page at /#/author. Only these users can create or edit lessons
# and crisis scenarios. Leave blank to disable authoring entirely.
#
# Example:
# AUTHOR_EMAILS=you@example.com,coauthor@example.com
# ============================================================
AUTHOR_EMAILS=

# ============================================================
# Multiplayer room dynamics
# ============================================================

# How often the server "ticks" the AI director. Higher = calmer.
ROOM_AI_TICK_INTERVAL_MS=10000

# Minimum gap between two AI delegate speeches in the same room.
# Real MUN speeches take time; 45–60s makes the room feel alive.
ROOM_AI_SPEAK_COOLDOWN_MS=50000

# Per-delegate "thinking" beat before a speech is broadcast.
# Jitter is added so delegates don't respond in lockstep.
ROOM_AI_THINK_MIN_MS=3500
ROOM_AI_THINK_MAX_MS=8000

# Chance an AI delegate chooses to pass instead of speaking when
# it's their turn. Creates natural gaps in the debate.
ROOM_AI_PASS_CHANCE=0.08

# Minimum gap between two AI-proposed motions in the same room.
ROOM_AI_MOTION_COOLDOWN_MS=90000

# How long a room must be quiet before the chair prompts for a motion.
ROOM_AI_CHAIR_IDLE_MS=45000

# How often the AI chair makes a "note" between groups of speakers.
ROOM_AI_CHAIR_BEAT_MS=60000

# AI delegate fill-in
ROOM_AI_FILL_DELAY_MS=15000
ROOM_AI_TARGET_SIZE=6

# Room persistence
ROOM_SNAPSHOT_DEBOUNCE_MS=2000